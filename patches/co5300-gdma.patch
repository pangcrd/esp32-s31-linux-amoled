+What:		/sys/class/spi_master/spiN/device/dma_stats
+Date:		November 2026
+Description:
+		Read-only ESP32-S31 GPSPI DMA statistics. dma_available indicates
+		whether both DMA channels were obtained. dma_enabled reports the
+		current dma_enable parameter; mapped transfers already queued may
+		still finish with DMA after the parameter is disabled.
+
+		tx_transfers and tx_bytes count successful host TX scatter-gather
+		DMA transactions and pixel/data bytes. A 411640-byte frame uses
+		13 transactions because MS_DLEN is limited to 32768 bytes.
+		errors counts failures in that TX scatter-gather path. Legacy
+		target/RX/duplex bounce transfers are outside these counters.
+		The counters reset at probe; reading this file neither transfers
+		data nor writes to the framebuffer console.
diff --git a/linux/Documentation/devicetree/bindings/dma/espressif,esp32s31-axi-gdma.yaml b/linux/Documentation/devicetree/bindings/dma/espressif,esp32s31-axi-gdma.yaml
new file mode 100644
index 0000000..7662772
--- /dev/null
+++ b/linux/Documentation/devicetree/bindings/dma/espressif,esp32s31-axi-gdma.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/dma/espressif,esp32s31-axi-gdma.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 AXI GDMA controller
+
+maintainers:
+  - pangcrd <pangcrd@users.noreply.github.com>
+
+description: |
+  Three independent receive/transmit channel pairs on the AXI bus. Descriptor
+  addresses are 8-byte aligned. The first DMA cell selects a directional
+  channel (RX0=0, TX0=1, RX1=2, TX1=3, RX2=4, TX2=5). The second selects the
+  peripheral (LCD/CAM=0, SPI2=1, SPI3=2, PARLIO=3, AES=4, SHA=5). One channel
+  per direction may connect to a given peripheral. GPIO-CS ownership remains
+  with the SPI controller and does not belong to this DMA controller.
+
+allOf:
+  - $ref: dma-controller.yaml#
+
+properties:
+  compatible:
+    const: espressif,esp32s31-axi-gdma
+  reg:
+    maxItems: 1
+  clocks:
+    maxItems: 1
+  resets:
+    maxItems: 1
+  interrupts:
+    minItems: 6
+    maxItems: 6
+  interrupt-names:
+    items:
+      - const: rx0
+      - const: tx0
+      - const: rx1
+      - const: tx1
+      - const: rx2
+      - const: tx2
+  "#dma-cells":
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - resets
+  - interrupts
+  - interrupt-names
+  - "#dma-cells"
+
+unevaluatedProperties: false
+...
